# Copy to .env.local and fill in. Everything except AUTH_SECRET is optional in development.

# Auth.js: generate with `npx auth secret` (or any 32+ random characters)
AUTH_SECRET=

# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# Leave empty in development to use an in-memory database with demo accounts.
MONGODB_URI=

# Google sign-in (optional): https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe (test mode): https://dashboard.stripe.com/test/apikeys
# Leave empty in development to simulate upgrades.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=

# Public URL of the app (used for Stripe redirect URLs). Defaults to the request host.
APP_URL=
